# Local development: isolated Postgres from `docker compose -f docker-compose.dev.yml up -d`
# (repo root). Never point this at the original Living Spring database.
DATABASE_URL=postgresql://church_saas:church_saas_dev@localhost:55440/church_saas

# Supabase on Render:
# Use the exact connection string from Supabase Dashboard -> Connect -> ORMs.
# Direct connection:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Shared pooler session mode, if direct IPv6 connectivity is not available:
# postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMS provider: arkesel | moolre | console (console only logs; use it locally).
SMS_PROVIDER=console
ARKESEL_API_KEY=
# Platform default sender ID, used for any church without its own. Arkesel only delivers from
# sender IDs registered in your Arkesel account: register one per church, then set it on the
# church (churches.sms_sender_id). New churches start with none, so they use this default.
ARKESEL_SENDER_ID=CHURCH
ARKESEL_BASE_URL=https://sms.arkesel.com

MOOLRE_VAS_KEY=
MOOLRE_SENDER_ID=CHURCH
MOOLRE_BASE_URL=https://api.moolre.com

# Comma-separated browser origins allowed to call the API (CORS).
# Local dev + your Vercel production and preview URLs, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app,https://your-app-git-main-org.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENDGRID_API_KEY=
# Platform default sender; replace with a domain you own and have verified in SendGrid.
FROM_EMAIL=noreply@example.com

# Links in invitation / password-reset emails point here (the frontend serves those pages).
FRONTEND_BASE_URL=http://localhost:5173
INVITE_EXPIRE_HOURS=168
PASSWORD_RESET_EXPIRE_MINUTES=60
# "console" logs emails instead of sending them. It is the only backend until a real
# provider is wired up, so invitations/resets are only visible in the server log for now.
EMAIL_BACKEND=console

# One-off, for scripts/bootstrap_platform_admin.py (no defaults; set both, then remove them):
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# --- SaaS platform ---
ENVIRONMENT=development          # production hides /docs and refuses the default SECRET_KEY
PRODUCT_NAME=Ekklesia
TRIAL_DAYS=14
TRIAL_PLAN=growth
GRACE_DAYS=7
SIGNUP_SMS_CREDITS=50
# fake = built-in test provider (never in production). manual = invoices paid offline and
# confirmed by an operator. seevplus = Seevplus hosted checkout (docs.seevcash.com): the API
# key decides sandbox vs live. BILLING_WEBHOOK_SECRET is the webhook endpoint's signing secret
# (shown once when you create the endpoint under Seev API -> Webhooks; point it at
# <api>/api/v1/billing/webhooks/seevplus and subscribe to payment.succeeded + payment.failed).
BILLING_PROVIDER=fake
BILLING_WEBHOOK_SECRET=
SEEVPLUS_API_KEY=
SEEVPLUS_BASE_URL=https://api.seevplus.com
SEEVPLUS_FALLBACK_EMAIL=
RATE_LIMIT_ENABLED=true
LOG_JSON=false
# Scheduled jobs: the cron caller sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
REMINDER_CATCHUP_MINUTES=180
