{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/index.py": { "maxDuration": 30, "excludeFiles": "{tests/**,venv/**,uploads/**,scripts/**}" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/v1/internal/cron/reminders", "schedule": "0 6 * * *" }]
}
